generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  editor
  viewer
}

enum ArticleStatus {
  draft
  published
  archived
}

model User {
  id        String    @id @default(uuid()) @db.Uuid
  login     String    @unique
  password  String
  role      UserRole
  createdAt BigInt
  updatedAt BigInt
  articles  Article[]
  comments  Comment[]
}

model Article {
  id         String        @id @default(uuid()) @db.Uuid
  title      String
  content    String
  status     ArticleStatus
  createdAt  BigInt
  updatedAt  BigInt
  authorId   String?       @db.Uuid
  categoryId String?       @db.Uuid
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments   Comment[]
  tags       Tag[]

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String
  articles    Article[]
}

model Comment {
  id        String  @id @default(uuid()) @db.Uuid
  content   String
  createdAt BigInt
  articleId String  @db.Uuid
  authorId  String? @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author    User?   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([authorId])
}

model Tag {
  id       String    @id @default(uuid()) @db.Uuid
  name     String    @unique
  articles Article[]
}

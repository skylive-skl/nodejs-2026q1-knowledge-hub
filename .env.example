PORT=4000

CRYPT_SALT=10
JWT_SECRET=secret123123
JWT_REFRESH_SECRET=secret123123
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
LOG_LEVEL=log
LOG_MAX_FILE_SIZE=1024

DISABLE_THROTTLE_FOR_TESTS=true

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=knowledge_hub
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Local app + Docker PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_hub?schema=public

# Docker app + Docker PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@db:5432/knowledge_hub?schema=public

GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash
AI_RATE_LIMIT_RPM=20
AI_CACHE_TTL_SEC=300
AI_HTTP_TIMEOUT_MS=15000
AI_RETRY_COUNT=3
AI_RETRY_BASE_DELAY_MS=300

GEMINI_EMBEDDING_MODEL=text-embedding-004
RAG_VECTOR_DB_PROVIDER=qdrant
RAG_VECTOR_DB_URL=http://vectordb:6333
RAG_VECTOR_COLLECTION=knowledge_hub_articles
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
RAG_CONVERSATION_MAX_MESSAGES=20
